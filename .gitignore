# Python and tooling
__pycache__/
*.py[cod]
*.pyd
*.so
.Python
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local environment and credentials
.env
.env.*
!.env.example
config/settings.json
config/outreach_settings.json
config/gmail_client_secret.json
config/gmail_token.json
config/*client_secret*.json
config/*token*.json
config/*token*.json.*
config/*token*.bak
!config/*.example.json

# Browser profiles contain cookies, sessions, history, and account data
chrome_profile*/
selenium_profile*/

# Runtime databases, exports, queues, and learning data
data/*
!data/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.xlsx
*.xls
job_data.json
job_application_summary.json

# Logs, crash data, screenshots, and captured web pages
# Local snapshots and exploratory scripts may contain personal application data.
/backups/
/scratch/
/.claude/
logs/*
!logs/.gitkeep
*.log
/login_attempt.html
/login_attempt.png
/nvoids_*.html
/nvoids_*.png
/rendered_search.html
/search_*.html
/search_*.png
/null

# Downloaded model cache
models/*
!models/.gitkeep

# OS and editor files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.lock
*.pre-v1.bak
*.question-memory-v1.bak
**/message_snapshots/
